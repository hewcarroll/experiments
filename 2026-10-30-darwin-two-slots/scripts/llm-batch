#!/usr/bin/env python3
"""Run a batch of bounded llm-task jobs against one Collective node, using all of its server slots at once.

  llm-batch --node darwin --jobs jobs.jsonl --out results.jsonl          # 2 at a time on darwin (its 2 slots)
  llm-batch --node kala   --jobs jobs.jsonl --out results.jsonl          # 1 at a time (kala has 1 slot)

Each line of --jobs is one job:
  {"id": "doc-17", "prompt": "Return {...} for this text:", "input": "chunks/doc-17.txt",
   "system": "Return only JSON.", "json": true, "quotes_from": "chunks/doc-17.txt",
   "max_tokens": 700, "temperature": 0}
Only "id" and "prompt" are required. Every job runs through ~/llm/bin/llm-task, so JSON slicing and the verbatim
quote check behave exactly as they do for a single call; a failed quote check is exit 1, as there.

Results are appended to --out one JSON line per finished job (id, exit, seconds, model timings, stdout, stderr), so an
interrupted batch resumes: ids already in --out are skipped. Workers default to the node's slot count; more workers
than slots only queue on the server. Stdlib only.
"""
import argparse
import concurrent.futures
import json
import os
import re
import subprocess
import sys
import threading
import time

LLM_TASK = os.path.expanduser("~/llm/bin/llm-task")
SLOTS = {"darwin": 2, "darwin-cpu": 1, "kala": 1, "kala-vl": 1}   # server --parallel settings, see llm-task --help
TIMING = re.compile(r"prompt (\d+) tok @ ([\d.]+)/s, gen (\d+) tok @ ([\d.]+)/s")


def run_job(node, job):
    cmd = [LLM_TASK, "--node", node]
    if job.get("json"):
        cmd.append("--json")
    if job.get("think"):
        cmd.append("--think")
    if job.get("system"):
        cmd += ["-s", job["system"]]
    if job.get("quotes_from"):
        cmd += ["--quotes-from", job["quotes_from"]]
    for key, flag in (("max_tokens", "--max-tokens"), ("temperature", "--temperature"), ("timeout", "--timeout")):
        if key in job:
            cmd += [flag, str(job[key])]
    cmd.append(job["prompt"])
    t0 = time.time()
    with (open(job["input"], "rb") if job.get("input") else open(os.devnull, "rb")) as stdin:
        p = subprocess.run(cmd, stdin=stdin, capture_output=True, timeout=int(job.get("timeout", 600)) + 60)
    out, err = p.stdout.decode(errors="replace"), p.stderr.decode(errors="replace")
    m = TIMING.search(err)
    return {"id": job["id"], "exit": p.returncode, "seconds": round(time.time() - t0, 2),
            "prompt_tok": int(m.group(1)) if m else None, "gen_tok": int(m.group(3)) if m else None,
            "gen_tok_s": float(m.group(4)) if m else None,
            "quote_fail": "quote(s) not found" in err, "stdout": out, "stderr": err[-2000:]}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--node", choices=SLOTS, required=True)
    ap.add_argument("--jobs", required=True, help="JSONL file, one job per line")
    ap.add_argument("--out", required=True, help="JSONL results file (appended; finished ids are skipped)")
    ap.add_argument("-j", "--workers", type=int, help="parallel requests (default: the node's slot count)")
    args = ap.parse_args()

    workers = args.workers or SLOTS[args.node]
    if workers > SLOTS[args.node]:
        print(f"[llm-batch] {args.node} has {SLOTS[args.node]} slot(s); extra workers will only queue", file=sys.stderr)
    jobs = [json.loads(l) for l in open(args.jobs) if l.strip()]
    ids = [j["id"] for j in jobs]
    if len(ids) != len(set(ids)):
        sys.exit("[llm-batch] job ids must be unique")
    done = set()
    if os.path.exists(args.out):
        done = {json.loads(l)["id"] for l in open(args.out) if l.strip()}
    todo = [j for j in jobs if j["id"] not in done]
    print(f"[llm-batch] {args.node}: {len(todo)} to run, {len(done & set(ids))} already done, {workers} at a time",
          file=sys.stderr)

    lock, t0, results = threading.Lock(), time.time(), []
    with open(args.out, "a") as out, concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = {pool.submit(run_job, args.node, j): j["id"] for j in todo}
        for fut in concurrent.futures.as_completed(futures):
            try:
                r = fut.result()
            except Exception as exc:   # timeout or launch failure: record it, keep going
                r = {"id": futures[fut], "exit": -1, "seconds": None, "quote_fail": False, "stdout": "",
                     "stderr": f"{type(exc).__name__}: {exc}"}
            with lock:
                out.write(json.dumps(r, ensure_ascii=False) + "\n")
                out.flush()
                results.append(r)
                print(f"[llm-batch] {r['id']}: exit {r['exit']} in {r['seconds']}s"
                      + (" (quote check failed)" if r["quote_fail"] else ""), file=sys.stderr)

    wall = time.time() - t0
    ok = sum(1 for r in results if r["exit"] == 0)
    gen = sum(r.get("gen_tok") or 0 for r in results)
    print(f"[llm-batch] done: {ok}/{len(results)} exit 0, {sum(r['quote_fail'] for r in results)} quote failures, "
          f"{wall:.1f}s wall, {gen / wall if wall else 0:.1f} generated tok/s overall", file=sys.stderr)
    sys.exit(0 if ok == len(results) else 1)


if __name__ == "__main__":
    main()
